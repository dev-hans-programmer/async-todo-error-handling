## This is a Mako template, not a migration that runs directly.
## Alembic renders this file whenever `alembic revision` creates a new file.
## Mako expressions use the `${...}` syntax and are replaced with values known
## by Alembic for the new revision.

## The generated file begins with a module docstring containing the revision
## message, revision identifier, parent revision, and creation timestamp.
"""${message}

Revision ID: ${up_revision}
Revises: ${down_revision | comma,n}
Create Date: ${create_date}

"""

## Sequence and Union describe revision identifiers that may be a single string,
## multiple strings for merge revisions, or None for the first revision.
from typing import Sequence, Union

## `op` is Alembic's operations interface. Generated migrations use it for
## actions such as `op.create_table`, `op.add_column`, and `op.drop_column`.
from alembic import op

## `sa` is the conventional alias for SQLAlchemy. Generated migrations use it
## to describe columns, types, constraints, indexes, and server defaults.
import sqlalchemy as sa

## Alembic inserts any additional imports required by autogenerate here.
## If no additional imports are needed, this expression renders an empty string.
