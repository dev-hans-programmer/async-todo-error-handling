    ## Insert generated upgrade operations here. Use `pass` when no operations
    ## were detected, so the generated function remains valid Python.
    ${upgrades if upgrades else "pass"}


## Alembic executes this function when reverting this revision. It should undo
## the changes made by `upgrade()` whenever a safe reversal is possible.
def downgrade() -> None:
