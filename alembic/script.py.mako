## These four values form Alembic's revision graph metadata.
## They are emitted as Python comments plus typed module-level variables.
# revision identifiers, used by Alembic.

## Unique identifier for this migration. Alembic uses it to locate the revision.
revision: str = ${repr(up_revision)}

## Parent revision. This is normally one revision ID, None for the first
## revision, or a sequence when the migration is a merge point.
down_revision: Union[str, Sequence[str], None] = ${repr(down_revision)}

## Optional branch names used to label migration branches.
branch_labels: Union[str, Sequence[str], None] = ${repr(branch_labels)}

## Optional dependency on another revision that is not this revision's direct
## parent. This is useful when migration branches must be ordered explicitly.
depends_on: Union[str, Sequence[str], None] = ${repr(depends_on)}


## Alembic executes this function when moving the database forward to this
## revision. Autogenerated upgrade operations are inserted into its body.
